{
  "permissions": {
    "allow": [
      "Bash(corepack pnpm lint*)",
      "Bash(corepack pnpm typecheck*)",
      "Bash(corepack pnpm test*)",
      "Bash(corepack pnpm check*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm check*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.env.*.local)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|*.css) cd \"$CLAUDE_PROJECT_DIR\" && ./node_modules/.bin/biome check --write --no-errors-on-unmatched \"$f\" >/dev/null 2>&1 ;; esac; } || true",
            "statusMessage": "Formatage Biome"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
