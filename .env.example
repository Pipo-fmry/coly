# Copier en .env.local (jamais commité). Aucune valeur réelle ici.
# Chaque variable est lue une seule fois, dans un module de config validé (pas de process.env éparpillé).

# Gmail — client OAuth « Application Web » d'un projet Google Cloud (docs/guides/testeurs.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Webapp (ADR 0016) — URL publique exacte (sert à l'URI de redirection OAuth et au cookie de session)
APP_URL=http://127.0.0.1:3000
# Secret de signature du cookie de session. Générer : openssl rand -base64 32
SESSION_SECRET=
# Adresses Gmail autorisées à créer un compte, séparées par des virgules (liste fermée en phase de test)
ALLOWED_EMAILS=

# Tracking
LAPOSTE_OKAPI_KEY=
AGGREGATOR_API_KEY=

# IA (fallback d'extraction uniquement, cf. docs/adr/0010)
ANTHROPIC_API_KEY=

# Chiffrement local des champs sensibles (tokens OAuth, codes de retrait). Générer : openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
